# Environment variables for testing environment
DEBUG=True
APP_ENV=testing
APP_TITLE=FastAPI Backend Template Test
PROJECT_NAME=FastAPI-Template-Test

# SQLite for testing
DB_ENGINE=sqlite

# JWT
SECRET_KEY=test_secret_key_for_testing_only_32_chars_long
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:3000,http://testserver

# Redis
REDIS_URL=redis://localhost:6379/1
CACHE_TTL=60

# Swagger
SWAGGER_UI_USERNAME=admin
SWAGGER_UI_PASSWORD=testpass123
