# Python Path Configuration
PYTHONPATH=src

# Application Settings
VERSION=1.0.0
APP_TITLE=Cody
PROJECT_NAME=Cody
APP_DESCRIPTION= backend API for Cody application

# secret key for JWT and other security-related operations
SECRET_KEY= SECRET_KEY
SWAGGER_UI_USERNAME=admin
SWAGGER_UI_PASSWORD=xxxxxx

# JWT
APP_ENV=development
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=240

# Database Configuration
DB_ENGINE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=codydb

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000

# Debug
DEBUG=False